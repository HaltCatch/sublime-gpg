[
    {
        "id": "file",
        "children":
        [
            { "caption": "-" },
            {
                "caption": "GPG: 加密为 .asc",
                "command": "gpg_encrypt_file"
            },
            {
                "caption": "GPG: .asc 签名",
                "command": "gpg_toggle_sign"
            },
            {
                "caption": "-"
            },
            {
                "caption": "GPG: 明文签名",
                "command": "gpg_clearsign_document"
            }
        ]
    },
    {
        "id": "preferences",
        "children":
        [
            {
                "id": "package-settings",
                "children":
                [
                    {
                        "caption": "GPG Auto",
                        "children":
                        [
                            {
                                "caption": "说明文档",
                                "command": "gpg_readme"
                            },
                            { "caption": "-" },
                            {
                                "caption": "配置文件",
                                "command": "edit_settings",
                                "args":
                                {
                                    "base_file": "${packages}/SublimeGPG/settings/gpg.sublime-settings",
                                    "default": "{\n\t$0\n}\n"
                                }
                            }
                        ]
                    }
                ]
            }
        ]
    }
]
